{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "research",
  "share": "disabled",
  "mcp": {
    "alpaca": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "alpaca"],
      "enabled": true,
      "timeout": 60000
    },
    "fmp": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "fmp"],
      "enabled": true,
      "timeout": 60000
    },
    "exa": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "exa"],
      "enabled": true,
      "timeout": 60000
    },
    "trusted": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "trusted"],
      "enabled": true,
      "timeout": 60000
    },
    "execution": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "authorization"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "*": "deny"
  }
}
