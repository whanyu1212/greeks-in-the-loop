{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "research",
  "share": "disabled",
  "agent": {
    "research": {
      "description": "Produces structured, non-executing SPY options research decisions.",
      "mode": "primary",
      "prompt": "{file:./src/research/research-agent-system.md}",
      "steps": 24,
      "permission": {
        "*": "deny",
        "alpaca_get_*": "allow",
        "fmp_*": "allow",
        "exa_*": "allow",
        "trusted_time": "allow",
        "read": {
          "*": "deny",
          "docs/**": "allow",
          "workspace/**": "allow"
        },
        "edit": {
          "*": "deny",
          "workspace/**": "allow"
        },
        "bash": "deny",
        "task": "deny",
        "skill": {
          "*": "deny",
          "spy-debit-spread-research": "allow"
        },
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny"
      }
    }
  },
  "mcp": {
    "alpaca": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "alpaca"],
      "enabled": true,
      "timeout": 60000
    },
    "fmp": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "fmp"],
      "enabled": true,
      "timeout": 60000
    },
    "exa": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "exa"],
      "enabled": true,
      "timeout": 60000
    },
    "trusted": {
      "type": "local",
      "command": ["node", "scripts/run-research-mcp.mjs", "trusted"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "alpaca_*": "deny"
  }
}
