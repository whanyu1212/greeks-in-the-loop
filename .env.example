ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Read-only option quote confirmation endpoint
ALPACA_MARKET_DATA_BASE_URL=https://data.alpaca.markets
# Read-only trading calendar endpoint
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
FMP_API_KEY=
EXA_API_KEY=

# Agent loop defaults
# Durable application state; keep this outside the agent-writable workspace.
# RESEARCH_LEDGER_PATH=.state/research-ledger.sqlite
AGENT_INTERVAL_MS=300000
AGENT_CYCLE_TIMEOUT_MS=120000
AGENT_CYCLE_ABORT_TIMEOUT_MS=5000
# Earliest research time on an Alpaca trading date, in America/New_York.
AGENT_PREMARKET_START_ET=08:00
# AGENT_MAX_CYCLES=10
# AGENT_TASK=Focus on liquid SPY defined-risk options setups.
# OPENCODE_SERVER_PORT=4096
# OPENCODE_SERVER_TIMEOUT_MS=60000

# Optional OpenTelemetry tracing (OTLP over HTTP/protobuf). Tracing is disabled
# unless an endpoint is set. A generic endpoint receives `/v1/traces`;
# a trace-specific endpoint is used exactly as written.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-project-name=greeks-in-the-loop
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
# OTEL_EXPORTER_OTLP_TIMEOUT=2000
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=2000
# OTEL_SDK_DISABLED=true

# Arize AX managed OTLP/HTTP example (US endpoint shown). Use the endpoint for
# your AX data region and copy the Space ID and API key from AX settings.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.arize.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=arize-space-id=YOUR_SPACE_ID,arize-api-key=YOUR_API_KEY
