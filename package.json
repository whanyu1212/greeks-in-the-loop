{
  "name": "greeks-in-the-loop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "opencode-ai"
    ]
  },
  "scripts": {
    "agent": "tsx src/index.ts",
    "agent:config": "node scripts/run-isolated-opencode.mjs debug agent research",
    "agent:mcp": "node scripts/run-isolated-opencode.mjs mcp list",
    "agent:once": "tsx src/index.ts --once",
    "agent:reset-breaker": "tsx src/event-ledger/research-loop-breaker-reset-cli.ts",
    "research:evaluate": "tsx src/evaluation/research-evaluate-cli.ts",
    "research:eval": "vitest run tests/research-behavior-evaluation.test.ts",
    "research:eval:live": "tsx src/evaluation/research-behavior-evaluate-cli.ts",
    "research:run": "tsx src/research/run/cli.ts",
    "risk:report": "tsx src/risk/risk-report-cli.ts",
    "backtest": "tsx src/backtest/backtest-cli.ts",
    "backtest:bars": "tsx src/backtest/alpaca-bar-proxy-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "2.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "1.18.21",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "dotenv": "17.4.2",
    "mcp-remote": "0.1.49",
    "opencode-ai": "1.18.21",
    "pg": "8.23.0",
    "picocolors": "^1.1.1",
    "tsx": "4.23.12",
    "undici": "7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "better-sqlite3": "13.0.3",
    "mermaid": "11.17.2",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "4.1.11"
  }
}
