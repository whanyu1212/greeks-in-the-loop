{
  "name": "greeks-in-the-loop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "opencode-ai"
    ]
  },
  "scripts": {
    "agent": "tsx src/index.ts",
    "agent:config": "node scripts/run-isolated-opencode.mjs debug agent research",
    "agent:mcp": "node scripts/run-isolated-opencode.mjs mcp list",
    "agent:once": "tsx src/index.ts --once",
    "agent:research-anytime": "tsx src/index.ts --once --research-anytime",
    "agent:skills": "node scripts/run-isolated-opencode.mjs debug skill",
    "research:evaluate": "tsx src/evaluation/research-evaluate-cli.ts",
    "research:run": "tsx src/research/research-run-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "2.8.0",
    "@opencode-ai/sdk": "1.18.21",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "mcp-remote": "0.1.49",
    "opencode-ai": "1.18.21",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
